# WiperX environment — copy to .env and fill in. Loaded automatically by
# run.py / the CLI / the web app when python-dotenv is installed.

# --- Web app ---
# REQUIRED for `python run.py` (unless --debug). Any long random string.
WIPERX_SECRET_KEY=
# "true" to set the Secure flag on session cookies (serve over HTTPS).
WIPERX_HTTPS=false
# Demo user-store passwords. If unset, random ones are generated and logged.
WIPERX_ADMIN_PASSWORD=
WIPERX_OPERATOR_PASSWORD=
WIPERX_VIEWER_PASSWORD=

# --- Report signing (Ed25519) ---
# Private signing key path (default: keys/wiperx_sign_key.pem, auto-generated).
WIPERX_SIGN_KEY=
# Trust anchor for `verify-report` (default: <sign key>.pub.pem).
WIPERX_VERIFY_PUBKEY=

# --- Remote targets ---
WIPERX_SSH_KEY_PATH=
WIPERX_KNOWN_HOSTS=
WIPERX_WINRM_USER=
WIPERX_WINRM_PASS=

# --- Path sandboxes (web) ---
# Restrict what the web eraser / recovery can touch.
WIPERX_ERASE_ALLOWED_ROOT=
WIPERX_RECOVER_ALLOWED_ROOT=

# --- Advanced ---
# "1" to allow raw slack-space zeroing on Linux as root.
WIPERX_ALLOW_RAW_SLACK=0

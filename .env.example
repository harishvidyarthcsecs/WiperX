# WiperX environment — copy to `.env` and edit. All values are optional except
# WIPERX_SECRET_KEY in a real deployment. `python-dotenv` auto-loads `.env`.

# ---- Web app --------------------------------------------------------------
WIPERX_SECRET_KEY=change-me-generate-with-secrets-token-hex-32
WIPERX_HTTPS=false
# WIPERX_HTTP_PORT=8080          # nginx published port (docker compose)

# ---- Report signing ----------------------------------------------------------
# WIPERX_SIGN_KEY=keys/wiperx_sign_key.pem
# WIPERX_VERIFY_PUBKEY=keys/wiperx_sign_key.pub.pem

# ---- Remote targets --------------------------------------------------------
# WIPERX_SSH_KEY_PATH=/home/svc/.ssh/wiperx_key
# WIPERX_KNOWN_HOSTS=/home/svc/.ssh/known_hosts
# WIPERX_WINRM_USER=Administrator
# WIPERX_WINRM_PASS=

# ---- Web form path jails --------------------------------------------------
# WIPERX_ERASE_ALLOWED_ROOT=/srv/wiperx/scratch
# WIPERX_RECOVER_ALLOWED_ROOT=/srv/wiperx/evidence

# ---- Optional: persistence (unset = in-memory stores) -------------------
# DATABASE_URL=postgresql://wiperx:pass@localhost/wiperx

# ---- Optional: LDAP / AD authentication --------------------------------
# WIPERX_LDAP_URL=ldaps://dc.example.com
# WIPERX_LDAP_BIND_DN=cn=svc,dc=example,dc=com
# WIPERX_LDAP_BIND_PASSWORD=
# WIPERX_LDAP_USER_BASE_DN=ou=people,dc=example,dc=com
# WIPERX_LDAP_ADMIN_GROUP=cn=wiperx-admins,ou=groups,dc=example,dc=com
# WIPERX_LDAP_OPERATOR_GROUP=cn=wiperx-operators,ou=groups,dc=example,dc=com
# WIPERX_LDAP_VIEWER_GROUP=cn=wiperx-viewers,ou=groups,dc=example,dc=com

# ---- Optional: SIEM forwarding -----------------------------------------
# WIPERX_SPLUNK_HEC_URL=https://splunk.example.com:8088/services/collector
# WIPERX_SPLUNK_HEC_TOKEN=
# WIPERX_ELASTIC_URL=https://es.example.com:9200
# WIPERX_ELASTIC_INDEX=wiperx-audit
# WIPERX_ELASTIC_API_KEY=

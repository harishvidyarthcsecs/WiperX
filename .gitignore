# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
.venv311/
venv/
env/

# Local secrets / env (keep .env.example tracked)
.env
.env.*
!.env.example

# WiperX runtime output (anchored to repo root - do NOT drop the leading "/":
# an unanchored "reports/" also matches web/templates/reports/, which made
# Tailwind's content scanner silently skip that directory - see the Part B
# page-pass commit that found this)
/reports/
/logs/
/cases/
/keys/
*.pdf

# Disk images / demo artefacts
*.dd
*.img
*.raw
*.E01
demo_mnt/

# Signing keys (never commit)
*.pem
*.key
wiperx_sign_key*

# Tooling
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Downloaded standalone tailwindcss binary (fetched by tools/build_css.sh,
# never committed - only its output web/static/css/app.css is tracked)
tools/.bin/

# Editor / OS
.vscode/
.idea/
.DS_Store
